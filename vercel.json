{
    "functions": {
        "api/cron.ts": { "maxDuration": 120 },
        "api/admin-generate.ts": { "maxDuration": 120 }
    },
    "redirects": [
        {
            "source": "/diagnosis",
            "destination": "/tools/diagnosis",
            "permanent": true
        },
        { "source": "/blog/running-shoe-cleaning-maintenance-guide", "destination": "/blog/running-shoe-cleaning-care-guide", "permanent": true },
        { "source": "/blog/high-arch-running-shoes", "destination": "/blog/high-arch-foot-running-shoes-guide", "permanent": true },
        { "source": "/blog/shin-splints-running-shoes", "destination": "/blog/shin-splints-running-shoes-guide", "permanent": true },
        { "source": "/blog/break-in-running-shoes", "destination": "/blog/running-shoe-break-in-guide", "permanent": true },
        { "source": "/blog/rainy-day-running-waterproof-shoes-guide", "destination": "/blog/running-in-rain-shoe-guide", "permanent": true },
        { "source": "/blog/nike-asics-newbalance-brand-comparison-2025", "destination": "/blog/running-shoe-brand-comparison-guide", "permanent": true },
        { "source": "/blog/marathon-sub5-training-plan-12weeks", "destination": "/blog/marathon-12week-training-plan-shoes", "permanent": true },
        { "source": "/blog/running-shoes-lifespan-replacement-guide", "destination": "/blog/when-to-replace-running-shoes-guide", "permanent": true },
        { "source": "/blog/running-shoe-insole-top5-recommendation", "destination": "/blog/running-shoe-insole-guide", "permanent": true },
        { "source": "/blog/budget-running-shoes-under-100k-2025", "destination": "/blog/budget-running-shoes-guide-2026", "permanent": true },
        { "source": "/blog/nike-pegasus-41-review-2025", "destination": "/blog/nike-pegasus-41-review", "permanent": true },
        { "source": "/blog/post-run-stretching-complete-routine", "destination": "/blog/running-post-run-recovery-routine-guide", "permanent": true }
    ],
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/rss.xml",
            "destination": "/api/rss"
        },
        {
            "source": "/feed.xml",
            "destination": "/api/rss"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), payment=()"
                }
            ]
        }
    ]
}
